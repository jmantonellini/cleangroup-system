<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_users_form_cleangroup_home_action" model="ir.ui.view">
        <field name="name">res.users.form.cleangroup.home.action</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <field name="action_id" position="attributes">
                <attribute name="groups">base.group_system</attribute>
            </field>
        </field>
    </record>

    <!-- Supervisor Dashboard Form -->
    <record id="view_supervisor_dashboard_form" model="ir.ui.view">
        <field name="name">cleangroup.supervisor.dashboard.form</field>
        <field name="model">cleangroup.supervisor.dashboard</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <sheet>
                    <div class="oe_title">
                        <h1>Panel del Supervisor</h1>
                        <h3>
                            <field name="user_id" readonly="1"/>
                        </h3>
                    </div>

                    <h2 style="margin-top: 20px;">Órdenes Activas</h2>
                    <field name="active_order_ids" readonly="1">
                        <list>
                            <field name="name"/>
                            <field name="partner_id"/>
                            <field name="location_id"/>
                            <field name="date"/>
                            <field name="state" widget="badge"/>
                            <field name="total_items"/>
                            <button name="action_open_from_dashboard" type="object" string="Abrir Orden" icon="fa-external-link"/>
                        </list>
                    </field>

                    <h2 style="margin-top: 30px;">Mis Ubicaciones</h2>
                    <field name="location_ids" readonly="1">
                        <list>
                            <field name="name"/>
                            <field name="partner_id"/>
                            <field name="warehouse_id"/>
                            <field name="today_employee_count"/>
                            <field name="order_count"/>
                            <field name="google_maps_url" invisible="1"/>
                            <button name="action_create_order" type="object" string="Nueva Orden" class="btn btn-sm btn-success"/>
                            <button name="action_open_google_maps" type="object" string="Mapa" icon="fa-map-marker" class="btn btn-sm btn-secondary" invisible="not google_maps_url"/>
                        </list>
                    </field>

                    <h2 style="margin-top: 30px;">Todas las Ubicaciones de mi Sede</h2>
                    <field name="sede_location_ids" readonly="1">
                        <list>
                            <field name="name"/>
                            <field name="partner_id"/>
                            <field name="warehouse_id"/>
                            <field name="supervisor_ids" widget="many2many_tags"/>
                            <field name="today_employee_count"/>
                            <field name="order_count"/>
                            <field name="google_maps_url" invisible="1"/>
                            <button name="action_create_order" type="object" string="Nueva Orden" class="btn btn-sm btn-success"/>
                            <button name="action_open_google_maps" type="object" string="Mapa" icon="fa-map-marker" class="btn btn-sm btn-secondary" invisible="not google_maps_url"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Server action to open dashboard -->
    <record id="action_open_supervisor_dashboard" model="ir.actions.server">
        <field name="name">Panel del Supervisor</field>
        <field name="model_id" ref="model_cleangroup_supervisor_dashboard"/>
        <field name="state">code</field>
        <field name="code"><![CDATA[
dashboard = env['cleangroup.supervisor.dashboard'].create({})
action = {
    'type': 'ir.actions.act_window',
    'name': 'Panel del Supervisor',
    'res_model': 'cleangroup.supervisor.dashboard',
    'res_id': dashboard.id,
    'view_mode': 'form',
    'target': 'current',
    'views': [(env.ref('cleangroup_operations.view_supervisor_dashboard_form').id, 'form')],
}
        ]]>        </field>
    </record>

    <!-- My Locations Kanban (alternative view) -->
    <record id="action_cleangroup_my_locations" model="ir.actions.act_window">
        <field name="name">Mis Ubicaciones</field>
        <field name="res_model">cleangroup.location</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('supervisor_ids', 'in', [uid])]</field>
        <field name="context">{'search_default_my_locations': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aún no tienes ubicaciones asignadas.
            </p>
        </field>
    </record>

    <!-- Reporting -->
    <record id="action_cleangroup_reporting" model="ir.actions.act_window">
        <field name="name">Reportes de Consumo</field>
        <field name="res_model">cleangroup.supply.order</field>
        <field name="view_mode">list,pivot,graph,form</field>
        <field name="search_view_id" ref="view_cleangroup_supply_order_search"/>
        <field name="context">{'group_by': ['date:month', 'location_id']}</field>
        <field name="help" type="html">
            <p>
                Ver consumo de insumos por ubicación y período de tiempo.
            </p>
        </field>
    </record>
</odoo>
