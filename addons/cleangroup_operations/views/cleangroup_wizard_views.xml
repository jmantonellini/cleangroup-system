<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_delivery_confirmation_wizard_form" model="ir.ui.view">
        <field name="name">cleangroup.delivery.confirmation.wizard.form</field>
        <field name="model">cleangroup.delivery.confirmation.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="order_id" readonly="1"/>
                    </group>
                    <group>
                        <group>
                            <field name="signature" widget="signature_pad" required="1"/>
                        </group>
                        <group>
                            <field name="delivery_photo" widget="image"/>
                        </group>
                    </group>
                    <field name="delivery_notes" placeholder="Agregar notas de entrega..."/>
                </sheet>
                <footer>
                    <button name="action_confirm_delivery" string="Confirmar Entrega" type="object" class="oe_highlight"/>
                    <button string="Cancelar" class="btn btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_weekday_schedule_wizard_form" model="ir.ui.view">
        <field name="name">cleangroup.weekday.schedule.wizard.form</field>
        <field name="model">cleangroup.weekday.schedule.wizard</field>
        <field name="arch" type="xml">
            <form string="Agregar Horario Lunes a Viernes">
                <sheet>
                    <group>
                        <field name="location_id"/>
                        <field name="employee_id"/>
                    </group>
                    <group>
                        <field name="start_time" widget="float_time"/>
                        <field name="end_time" widget="float_time"/>
                    </group>
                    <p class="text-muted">
                        Se crearán o actualizarán los horarios de lunes a viernes para esta ubicación y empleado.
                    </p>
                </sheet>
                <footer>
                    <button name="action_apply" string="Agregar Horarios" type="object" class="oe_highlight"/>
                    <button string="Cancelar" class="btn btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
