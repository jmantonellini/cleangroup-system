<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="category_cleangroup_operations" model="ir.module.category">
    <field name="name">CleanGroup Insumos</field>
    <field name="sequence">35</field>
  </record>

  <record id="group_cleangroup_supply_user" model="res.groups">
    <field name="name">Supervisor de Sede</field>
    <field name="category_id" ref="cleangroup_operations.category_cleangroup_operations"/>
    <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('stock.group_stock_user'))]"/>
  </record>

  <record id="group_cleangroup_supply_manager" model="res.groups">
    <field name="name">Administrador de Ubicaciones y Horarios</field>
    <field name="category_id" ref="cleangroup_operations.category_cleangroup_operations"/>
    <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
  </record>
</odoo>
